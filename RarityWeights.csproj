<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SlipSkid.RarityWeights</AssemblyName>
    <RootNamespace>RarityWeights</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Override on the command line: -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Steam\steamapps\common\Slip &amp; Skid</GameDir>
    <Managed>$(GameDir)\Slip &amp; Skid_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.Mono.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Localization.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Netcode.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\RarityWeights" />
  </Target>
</Project>
